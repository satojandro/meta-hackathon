# Copy to .env and fill in. Never commit .env.
META_API_KEY=          # dev.meta.ai: Meta Model API (Muse Spark)
META_API_BASE=https://api.meta.ai/v1
FIREWORKS_API_KEY=     # fireworks.ai (optional: hosted Glimmer / Spark Open)
HF_TOKEN=              # huggingface.co (Llama 3.2 is gated: accept the license on its model page)
# Optional: which model to load. Ungated mirror of Llama 3.2 1B (same weights and licence) while
# access to meta-llama/Llama-3.2-1B-Instruct is pending:
# MODEL_ID=unsloth/Llama-3.2-1B-Instruct
# Modal uses its own CLI auth: run `modal setup` once
