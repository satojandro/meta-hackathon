# Copy to .env and fill in. Never commit .env.
# Local steering needs no keys at all: MODEL_ID alone is enough.
#
# Which weights to load. This mirror is ungated, so downloads work with no token; it is the same
# 1.24B weights and licence as meta-llama/Llama-3.2-1B-Instruct.
MODEL_ID=unsloth/Llama-3.2-1B-Instruct
# Official gated repo (needs HF_TOKEN plus licence approval on its model page), if you prefer it:
# MODEL_ID=meta-llama/Llama-3.2-1B-Instruct
META_API_KEY=          # dev.meta.ai: Meta Model API (Muse Spark)
META_API_BASE=https://api.meta.ai/v1
FIREWORKS_API_KEY=     # fireworks.ai (optional: hosted Glimmer / Spark Open)
HF_TOKEN=              # huggingface.co (only for gated meta-llama/* repos; read scope is enough)
# Modal uses its own CLI auth: run `modal setup` once
